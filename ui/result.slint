import { Button, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export component ResultWindow inherits Window {
    title: "翻译结果";
    width: 780px;
    height: 620px;
    always-on-top: root.pinned;
    background: #f7f8fa;
    forward-focus: keyboard;

    in-out property <image> result-image;
    in-out property <string> translation-text: "";
    in-out property <string> status-text: "";
    in-out property <string> error-text: "";
    in-out property <bool> is-translating: false;
    in-out property <bool> pinned: true;
    in-out property <float> zoom-factor: 1.0;

    callback copy-text();
    callback copy-image();
    callback save-image();
    callback retry();
    callback open-settings();
    callback open-history();
    callback cancel-translation();
    callback pin-changed(bool);
    callback zoom-changed(float);
    callback close-requested();

    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.is-translating {
                    root.cancel-translation();
                } else {
                    root.close-requested();
                }
                return accept;
            }
            reject
        }
    }

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            Text {
                text: root.is-translating ? "正在翻译…" : "翻译结果";
                color: #172033;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.pinned ? "已钉住" : "钉住";
                clicked => {
                    root.pinned = !root.pinned;
                    root.pin-changed(root.pinned);
                }
            }
            Button {
                text: "历史";
                clicked => { root.open-history(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #20242c;
            border-radius: 8px;
            clip: true;

            ScrollView {
                Image {
                    source: root.result-image;
                    image-fit: contain;
                    width: max(self.source.width * root.zoom-factor * 1px, parent.width);
                    height: max(self.source.height * root.zoom-factor * 1px, parent.height);
                }
            }

            Rectangle {
                visible: root.is-translating;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 220px;
                height: 76px;
                border-radius: 9px;
                background: #101828dd;
                VerticalBox {
                    padding: 10px;
                    spacing: 6px;
                    Text {
                        text: root.status-text == "" ? "正在识别并翻译…" : root.status-text;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "取消";
                        clicked => { root.cancel-translation(); }
                    }
                }
            }
        }

        Rectangle {
            visible: root.error-text != "";
            height: 52px;
            border-radius: 7px;
            border-width: 1px;
            border-color: #fda29b;
            background: #fef3f2;
            HorizontalBox {
                padding: 8px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.error-text;
                    color: #b42318;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button {
                    text: "重试";
                    clicked => { root.retry(); }
                }
                Button {
                    text: "打开设置";
                    clicked => { root.open-settings(); }
                }
            }
        }

        Rectangle {
            visible: root.status-text != "" && root.error-text == "" && !root.is-translating;
            height: 38px;
            border-radius: 6px;
            background: #eff4ff;
            Text {
                text: root.status-text;
                color: #175cd3;
                x: 10px;
                width: parent.width - 20px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "复制译文";
                enabled: !root.is-translating;
                clicked => { root.copy-text(); }
            }
            Button {
                text: "复制图片";
                enabled: !root.is-translating;
                clicked => { root.copy-image(); }
            }
            Button {
                text: "保存 PNG";
                enabled: !root.is-translating;
                clicked => { root.save-image(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "−";
                enabled: root.zoom-factor > 0.25;
                clicked => {
                    root.zoom-factor = max(0.25, root.zoom-factor - 0.25);
                    root.zoom-changed(root.zoom-factor);
                }
            }
            Text {
                text: round(root.zoom-factor * 100) + "%";
                color: #475467;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 54px;
            }
            Button {
                text: "+";
                enabled: root.zoom-factor < 4.0;
                clicked => {
                    root.zoom-factor = min(4.0, root.zoom-factor + 0.25);
                    root.zoom-changed(root.zoom-factor);
                }
            }
            Button {
                text: "重置";
                clicked => {
                    root.zoom-factor = 1.0;
                    root.zoom-changed(root.zoom-factor);
                }
            }
            Button {
                text: root.is-translating ? "取消" : "关闭";
                clicked => {
                    if root.is-translating {
                        root.cancel-translation();
                    } else {
                        root.close-requested();
                    }
                }
            }
        }
    }
}
